<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageButton
        android:id="@+id/health_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/health_check"
        android:contentDescription="@string/health_check"
        android:layout_margin="12sp"
        android:background="@android:color/transparent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/health_check"
        android:layout_marginTop="20sp"
        android:text="@string/health_check"/>



    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/switch_main"
        android:layout_centerHorizontal="true"
        android:textSize="24sp"
        android:layout_marginBottom="32dp"
        android:text="@string/general_switch"
        />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleX="4.0"
        android:scaleY="4.0"
        android:layout_centerInParent="true"
        />


    <TextView
        android:id="@+id/sftpgo_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="32sp"
        android:text="@string/current_state_closed"
        android:textSize="18sp"
        android:textColor="#666666"
        android:layout_below="@id/switch_main"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp" />
</RelativeLayout>